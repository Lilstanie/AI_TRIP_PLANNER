      "label": "onProgress(event) 回调",
      "variant": "dashed"
    },
    {
      "from": "route",
      "to": "browser",
      "y": 400,
      "label": "逐行发送 NDJSON 进度帧",
      "variant": "dashed"
    },
    {
      "from": "agents",
      "to": "graph",
      "y": 430,
      "label": "通过共享 schema 的提案",
      "variant": "return"
    },
    {
      "from": "graph",
      "to": "chat",
      "y": 460,
      "label": "校验后的 TripPlan",
      "variant": "return"
    },
    {
      "from": "route",
      "to": "store",
      "y": 490,
      "label": "保存最终计划",
      "variant": "emphasis"
    },
    {
      "from": "route",
      "to": "browser",
      "y": 520,
      "label": "complete { response } 终帧",
      "variant": "return"
    },
    {
      "from": "browser",
      "to": "traveller",
      "y": 550,
      "label": "解析契约并更新工作区",
      "variant": "return"
    }
  ],
  "activations": [
    {
      "participant": "route",
      "from": 190,
      "to": 570,
      "type": "backend"
    },
    {
      "participant": "chat",
      "from": 220,
      "to": 465,
      "type": "backend"
    },
    {
      "participant": "agents",
      "from": 280,
      "to": 430,
      "type": "cloud"
    },
    {
      "participant": "graph",
      "from": 335,
      "to": 445,
      "type": "backend"
    },
    {
      "participant": "store",
      "from": 490,
      "to": 510,
      "type": "database"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "正常规划路径",
      "items": [
        "进度事件在规划运行期间经 onProgress 连续发送",
        "完整结果通过 ChatResponse 校验后才保存并发送 complete"
      ]
    },
    {
      "dot": "orange",
      "title": "本轮不生成计划的结果",
      "items": [
        "缺少需求时返回 needs_info；coordinator 追问返回 ask_user",
        "识别到航班问价时直接回传 FlightAnswer，不运行规划图"
      ]
    },
    {
      "dot": "emerald",
      "title": "错误边界",
      "items": ["非法 ChatRequest 在开始流之前返回 400", "规划异常以 error 帧结束本轮"]
    }
  ]
}
