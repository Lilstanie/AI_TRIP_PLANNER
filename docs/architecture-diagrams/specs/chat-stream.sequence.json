      "sublabel": "协调对话与行程"
    },
    {
      "id": "agents",
      "type": "cloud",
      "label": "LangChain",
      "sublabel": "对话协调与专家代理"
    },
    {
      "id": "graph",
      "type": "backend",
      "label": "LangGraph",
      "sublabel": "确定性规划图"
    },
    {
      "id": "store",
      "type": "database",
      "label": "tripStore",
      "sublabel": "校验后保存计划"
    }
  ],
  "segments": [
    {
      "from": 145,
      "to": 258,
      "label": "请求接收"
    },
    {
      "from": 270,
      "to": 448,
      "label": "协调与规划"
    },
    {
      "from": 450,
      "to": 575,
      "label": "流式返回与保存"
    }
  ],
  "messages": [
    {
      "from": "traveller",
      "to": "browser",
      "y": 160,
      "label": "提交消息与行程需求",
      "variant": "emphasis"
    },
    {
      "from": "browser",
      "to": "route",
      "y": 190,
      "label": "POST /api/chat + 数据模式",
      "variant": "emphasis"
    },
    {
      "from": "route",
      "to": "chat",
      "y": 220,
      "label": "runTripChat(request, onProgress)",
      "variant": "default"
    },
    {
      "from": "chat",
      "to": "agents",
