{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "工作区存储、账号同步与服务端记忆",
    "output": "docs/architecture-diagrams/data-and-storage/rendered/storage-sync.html",
    "quality_profile": "showcase",
    "locale": "zh-CN",
    "views": [
      {
        "id": "browser",
        "label": "浏览器工作目录",
        "focus": ["workspace", "catalog", "accountSync", "syncApi", "accountDb"],
        "note": "localStorage 是聊天与行程的工作存储；登录后与账号记录合并并同步。"
      },
      {
        "id": "server",
        "label": "服务端 Services",
        "focus": ["chatApi", "memory", "tripStore", "jsonStore", "redis", "process"],
        "note": "MemoryStore 和最新计划 store 共用 jsonStore 持久化边界。"
      },
      {
        "id": "fallback",
        "label": "失败与回退",
        "focus": ["catalog", "accountSync", "chatApi", "jsonStore", "process"],
        "note": "同步失败时保留本地修改；未配置 Redis 时使用进程内存。"
      },
      {
        "id": "longterm",
        "label": "长期记忆",
        "focus": ["chatApi", "memory", "accountMem", "memApi"],
        "note": "登录且开启记忆时，长期偏好存在账号数据库；短期对话轮次仍走 jsonStore。"
      }
    ]
  },
  "lanes": [
    {
      "id": "browser",
      "label": "浏览器与账号 API"
    },
    {
      "id": "account",
      "label": "账号数据库（Postgres）"
    },
    {
      "id": "planner",
      "label": "聊天与服务"
    },
    {
      "id": "durable",
      "label": "jsonStore 后端"
    }
  ],
  "phases": [
    {
      "id": "workspace",
      "label": "本地工作区",
      "fromCol": 0,
      "toCol": 2,
      "variant": "emphasis"
    },
    {
      "id": "remote",
      "label": "账号同步",
      "fromCol": 3,
      "toCol": 3
    },
    {
      "id": "memory",
      "label": "长期记忆",
      "fromCol": 4,
      "toCol": 4
    }
  ],
  "mainPath": ["workspace", "catalog", "accountSync", "syncApi", "accountDb"],
  "nodes": [
    {
      "id": "workspace",
      "lane": "browser",
      "col": 0,
      "type": "frontend",
      "label": "工作区界面"
    },
    {
      "id": "catalog",
      "lane": "browser",
      "col": 1,
      "type": "database",
      "label": "浏览器目录"
    },
    {
      "id": "accountSync",
      "lane": "browser",
      "col": 2,
      "type": "backend",
      "label": "useAccountSync"
    },
    {
      "id": "syncApi",
      "lane": "browser",
      "col": 3,
      "type": "backend",
      "label": "/api/account/sync"
    },
    {
      "id": "accountDb",
      "lane": "account",
      "col": 3,
      "type": "database",
      "label": "账号数据库",
      "sublabel": "trips · conversations"
    },
    {
      "id": "chatApi",
      "lane": "planner",
      "col": 0,
      "type": "backend",
      "label": "聊天 / 编排器"
    },
    {
      "id": "memory",
      "lane": "planner",
      "col": 2,
      "type": "backend",
      "label": "MemoryStore",
      "sublabel": "短期轮次 · 长期偏好"
    },
    {
      "id": "tripStore",
      "lane": "durable",
      "col": 1,
      "type": "backend",
      "label": "tripStore"
    },
    {
      "id": "jsonStore",
      "lane": "planner",
      "col": 3,
      "type": "backend",
      "label": "jsonStore"
    },
    {
      "id": "redis",
      "lane": "durable",
      "col": 3,
      "type": "database",
      "label": "Redis REST"
    },
    {
      "id": "process",
      "lane": "durable",
      "col": 4,
      "type": "database",
      "label": "进程内存"
    },
    {
      "id": "memApi",
      "lane": "browser",
      "col": 4,
      "type": "backend",
      "label": "/api/account/memory",
      "sublabel": "查看 · 删除 · 撤销"
    },
    {
      "id": "accountMem",
      "lane": "account",
      "col": 4,
      "type": "database",
      "label": "账号记忆",
      "sublabel": "account_memories"
    }
  ],
  "edges": [
    {
      "id": "workspace-catalog",
      "from": "workspace",
      "to": "catalog",
      "label": "防抖自动保存",
      "role": "main"
    },
    {
      "id": "catalog-sync",
      "from": "catalog",
      "to": "accountSync",
      "label": "发生变更的记录",
      "role": "main"
    },
    {
      "id": "sync-request",
      "from": "accountSync",
      "to": "syncApi",
      "label": "GET 拉取合并 · POST 推送",
      "role": "main"
    },
    {
      "id": "sync-database",
      "from": "syncApi",
      "to": "accountDb",
      "label": "写入行程和对话",
      "role": "main"
    },
    {
      "id": "chat-memory",
      "from": "chatApi",
      "to": "memory",
      "label": "追加对话轮次",
      "role": "main"
    },
    {
      "id": "chat-plan",
      "from": "chatApi",
      "to": "tripStore",
      "label": "已校验的计划",
      "role": "branch"
    },
    {
      "id": "memory-json",
      "from": "memory",
      "to": "jsonStore",
      "label": "短期对话轮次",
      "role": "main"
    },
    {
      "id": "plan-json",
      "from": "tripStore",
      "to": "jsonStore",
      "label": "保存最新计划",
      "role": "branch",
      "toSide": "bottom"
    },
    {
      "id": "json-redis",
      "from": "jsonStore",
      "to": "redis",
      "label": "已配置 URL 和 token",
      "role": "main"
    },
    {
      "id": "json-process",
      "from": "jsonStore",
      "to": "process",
      "label": "未配置时",
      "role": "error",
      "variant": "dashed"
    },
    {
      "id": "memory-account",
      "from": "memory",
      "to": "accountMem",
      "label": "长期偏好",
      "role": "branch"
    },
    {
      "id": "memapi-account",
      "from": "memApi",
      "to": "accountMem",
      "label": "设置页管理",
      "role": "branch"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "工作区目录",
      "items": [
        "已保存的聊天和行程从浏览器 localStorage 读取",
        "登录时账号同步拉取并合并记录；本地变更稍后推送"
      ]
    },
    {
      "dot": "amber",
      "title": "服务端存储范围",
      "items": [
        "tripStore 按 trip ID 保存最新计划；它不是工作区行程目录",
        "MemoryStore 和 tripStore 通过 jsonStore 使用 Redis REST 或进程内存",
        "长期偏好（如住宿类型、评分、取消政策）写入 Postgres account_memories；聊天识别到“记住…”会写入并可撤销"
      ]
    },
    {
      "dot": "emerald",
      "title": "失败处理",
      "items": [
        "账号同步失败时保留浏览器中的待同步变更",
        "进程内存状态在重启或 serverless 冷启动后消失"
      ]
    }
  ]
}
