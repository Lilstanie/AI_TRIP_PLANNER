  "cards": [
    {
      "dot": "cyan",
      "title": "正常规划路径",
      "items": [
        "进度事件在规划运行期间经 onProgress 连续发送",
        "ChatResponse 校验通过后先发 complete，再保存到 tripStore；保存失败只记日志，不影响已送达的计划"
      ]
    },
    {
      "dot": "orange",
      "title": "本轮不生成计划的结果",
      "items": [
        "缺少需求时返回 needs_info；coordinator 追问返回 ask_user（一次一个问题）",
        "识别到航班问价时直接回传 FlightAnswer，不运行规划图；@提及只重跑被点名的专家"
      ]
    },
    {
      "dot": "emerald",
      "title": "账号与错误边界",
      "items": [
        "登录且开启记忆时才读写账号记忆；生产环境未登录时不调用模型",
        "非法 ChatRequest 在开始流之前返回 400；规划异常以 error 帧结束本轮"
      ]
    }
  ]
