{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Chat 请求与 LangChain 使用位置",
    "output": "chat-langchain.html",
    "quality_profile": "showcase",
    "locale": "zh-CN",
    "views": [
      {
        "id": "conversation",
        "label": "LangChain 对话流程",
        "focus": [
          "traveller",
          "workspace",
          "route",
          "tripChat",
          "coordinator",
          "briefTool",
          "questionTool",
          "planTool",
          "workflow",
          "stream"
        ],
        "note": "createAgent 通过三个 schema 工具理解消息、追问或启动规划。"
      },
      {
        "id": "plan",
        "label": "进入规划",
        "focus": ["coordinator", "planTool", "workflow", "stream"],
        "note": "replan_trip 将完整 brief 交给 LangGraph，由图完成计划。"
      },
      {
        "id": "offline",
        "label": "无模型回退",
        "focus": ["tripChat", "offline", "workflow", "stream"],
        "note": "未配置 provider key 时使用规则提取和确定性规划路径。"
      }
    ]
  },
