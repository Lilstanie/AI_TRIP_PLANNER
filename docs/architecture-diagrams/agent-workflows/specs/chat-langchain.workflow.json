        "note": "createAgent 通过三个 schema 工具理解消息、追问或启动规划。"
      },
      {
        "id": "plan",
        "label": "进入规划",
        "focus": ["coordinator", "planTool", "workflow", "stream"],
        "note": "replan_trip 将完整 brief 交给 LangGraph，由图完成计划。"
      },
      {
        "id": "offline",
        "label": "无模型回退",
