  "edges": [
    {
      "id": "person-workspace",
      "from": "traveller",
      "to": "workspace",
      "role": "main"
    },
    {
      "id": "workspace-route",
      "from": "workspace",
      "to": "route",
      "label": "ChatRequest",
      "role": "main"
    },
    {
      "id": "route-tripChat",
      "from": "route",
      "to": "tripChat",
      "label": "通过校验的请求",
      "role": "main"
    },
    {
      "id": "tripChat-agent",
      "from": "tripChat",
      "to": "coordinator",
      "label": "模型可用",
      "role": "main"
    },
    {
      "id": "tripChat-offline",
      "from": "tripChat",
      "to": "offline",
      "label": "未配置模型密钥",
      "role": "error",
      "variant": "dashed"
    },
    {
      "id": "agent-brief",
      "from": "coordinator",
      "to": "briefTool",
      "label": "记录行程事实",
      "role": "branch"
    },
    {
      "id": "brief-agent",
      "from": "briefTool",
      "to": "coordinator",
      "label": "合并后的已知事实",
      "role": "return"
    },
    {
      "id": "agent-question",
      "from": "coordinator",
      "to": "questionTool",
      "label": "需要补充信息",
      "role": "branch"
    },
    {
      "id": "agent-plan",
      "from": "coordinator",
      "to": "planTool",
      "label": "规划请求或影响计划的更改",
      "role": "main"
    },
    {
      "id": "plan-workflow",
      "from": "planTool",
      "to": "workflow",
      "label": "TripBrief",
      "role": "main"
    },
    {
      "id": "offline-workflow",
      "from": "offline",
      "to": "workflow",
      "label": "规则提取出的行程需求",
      "role": "branch"
    },
    {
      "id": "question-stream",
      "from": "questionTool",
      "to": "stream",
      "label": "ask_user / needs_info 数据帧",
      "role": "return"
    },
    {
      "id": "workflow-stream",
      "from": "workflow",
      "to": "stream",
      "label": "已校验的计划和回复",
      "role": "return"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "LangChain 的用途",
      "items": [
        "createAgent 用于对话协调器和监督器的工具调用循环",
        "模型在带类型的工具中选择；规划状态流转由 LangGraph 控制"
      ]
    },
    {
      "dot": "emerald",
      "title": "追问与规划",
      "items": [
        "信息不全时通过 needs_info 或 ask_user 结束本轮，旅客在下一条消息回答",
        "只有行程需求通过校验后，replan_trip 才调用规划流程"
      ]
    },
    {
      "dot": "amber",
      "title": "模型回退",
      "items": [
        "未配置模型密钥时使用本地行程提取和确定性回复路径",
        "单独的机票价格查询直接访问 booking，不运行行程规划"
      ]
    }
  ]
}
