{
  "name": "ai-trip-planner",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/link-env.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "mock-server": "pnpm --filter @trip/tools mock-server",
    "format": "prettier --write .",
    "verify:protected": "node scripts/verify-protected-files.mjs"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.18"
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^4.0.0"
  }
}
