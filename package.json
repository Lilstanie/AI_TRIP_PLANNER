{
  "name": "ai-trip-planner",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/link-env.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "mock-server": "pnpm --filter @trip/tools mock-server",
    "format": "prettier --write .",
    "format:check-changed": "node scripts/format-check-changed.mjs",
    "verify:protected": "node scripts/verify-protected-files.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:e2e-selectors": "node scripts/verify-e2e-selectors.mjs",
    "verify:pairs": "node .agents/skills/translate-docs/scripts/check-pairs.mjs",
    "test:scripts": "node --test \"scripts/*.test.mjs\""
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.18"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8",
    "vitest": "^4.0.0"
  }
}
