# LLM — OpenRouter (OpenAI-compatible). Put the real key in .env.local, never commit it.
# Free key from https://openrouter.ai/keys. Free models are rate-limited; @trip/llm retries.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openrouter/free

# Orchestration engine: leave unset for the hand-rolled loop, "true" for the LangGraph graph.
USE_GRAPH=

# External tools: true = use local mocks, no real key needed for development.
USE_MOCK_TOOLS=true
MAPS_API_KEY=
MOCK_API_URL=http://localhost:4000

# Memory store (E owns this — swap for SQLite/Redis later)
DATABASE_URL=file:./dev.db
# REDIS_URL=redis://localhost:6379
