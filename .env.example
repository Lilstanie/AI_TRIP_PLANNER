# ---------------------------------------------------------------------------
# Model layer. Different tasks use different providers (see docs). Keys are
# read from the environment only — put real values in .env.local, never commit.
# We are not using Claude/Anthropic in this project.
# ---------------------------------------------------------------------------

# Chat: extract explicit trip updates from a user message (strict JSON).
GPT_API_KEY=
GPT_MODEL=gpt-5.6-luna
GPT_REASONING_EFFORT=high
GPT_BASE_URL=https://api.openai.com/v1

# Itinerary generation (OpenAI-compatible endpoint).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# MiniMax is wired up but NOT currently routed to any agent: it answered in
# 15-25s per structured call, which pushed a full page render to 37-81s against
# ~20s on DeepSeek. See MODEL_ROUTING in packages/agents/src/models.ts to switch
# destination-guide and dining back to it.
# MiniMax runs two independent account systems: the mainland-China site
# (api.minimaxi.com) and the international site (api.minimax.io). Keys are NOT
# interchangeable — using one site's key against the other returns HTTP 401
# "invalid api key (2049)". The default below is the mainland-China endpoint.
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# When any model call fails or returns something off-schema, agents fall back to
# deterministic output — the request always completes.

# External tools: true = use local mocks, no real key needed for development.
USE_MOCK_TOOLS=true
# Set USE_MOCK_TOOLS=false to use free OpenStreetMap Nominatim + OSRM.
MAPS_PROVIDER=osm
OSM_USER_AGENT=ai-trip-planner/1.0 (contact@example.com)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org
MAPS_API_KEY=
MOCK_API_URL=http://localhost:4000

# Memory store (E owns this — swap for SQLite/Redis later)
DATABASE_URL=file:./dev.db
# REDIS_URL=redis://localhost:6379
