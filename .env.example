# ---------------------------------------------------------------------------
# Model layer. Keys are read from the environment only — put real values in
# .env.local, never commit.
#
# DeepSeek is the only provider in use. The OpenAI and Anthropic adapters were
# removed, and MiniMax stays wired but unrouted; see the note below.
# ---------------------------------------------------------------------------

# Extraction of explicit trip updates from a chat message, all five specialists,
# the supervisor agent and chat replies, through one OpenAI-compatible endpoint.
# See MODEL_ROUTING in packages/agents/src/models.ts. Without a key, a
# conservative local rule parser handles extraction instead.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# MiniMax is wired up but NOT currently routed to any agent: it answered in
# 15-25s per structured call, which pushed a full page render to 37-81s against
# ~20s on DeepSeek. See MODEL_ROUTING in packages/agents/src/models.ts to switch
# destination-guide and dining back to it.
# MiniMax runs two independent account systems: the mainland-China site
# (api.minimaxi.com) and the international site (api.minimax.io). Keys are NOT
# interchangeable — using one site's key against the other returns HTTP 401
# "invalid api key (2049)". The default below is the mainland-China endpoint.
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# When any model call fails or returns something off-schema, agents fall back to
# deterministic output — the request always completes.

# Agent tools: true = in-process map, booking and weather fixtures, no real key
# needed. This is the deployment default; the workspace's top-bar toggle can
# choose mock or live per request (x-trip-data-mode header).
USE_MOCK_TOOLS=true
# With USE_MOCK_TOOLS=false, MAPS_PROVIDER selects the agents' maps adapter:
# "osm" (free Nominatim + OSRM) or "google" (requires MAPS_API_KEY). If unset,
# google is chosen when MAPS_API_KEY is present, otherwise osm.
# Booking (accommodation/hotels) only has a "google" real mode — there is no
# free hotel-pricing API to pair with OSM. With USE_MOCK_TOOLS=false and
# MAPS_PROVIDER=osm, dining/destination-guide/routes still work for free, but
# accommodation will throw "Unsupported booking provider: osm"; set
# MAPS_PROVIDER=google (with MAPS_API_KEY) to get real, grounded hotel
# candidates — the nightly price is still a planning estimate, never a live
# quote (Google has no public live hotel-pricing API).
MAPS_PROVIDER=osm
# Nominatim requires a real contact; replace the placeholder before real traffic.
OSM_USER_AGENT=ai-trip-planner/1.0 (contact@example.com)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org
# Base URL for the "google" provider's Routes calls (override only for testing).
# MAPS_API_BASE_URL=https://routes.googleapis.com

# Google Maps Platform for the web workspace (and the "google" provider above).
# Server key: Places search/details, Routes and Time Zone API routes.
MAPS_API_KEY=
# Browser key and optional Map ID for the Maps JavaScript map. Without the key the
# workspace shows a map fallback; the itinerary stays usable.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# SerpApi (Google Hotels + Google Flights, live prices) — one key covers both.
# With USE_MOCK_TOOLS=false, hotels prefer this over the Google Places estimate
# above (falling back to it on any SerpApi failure); flights have no other real
# provider, so a SerpApi failure there is a thrown error, not a silent mock
# fare. Both engines share one monthly counter (230 searches total, see
# packages/tools/src/serpapi.ts) and one short result cache. Leave blank to
# keep using the Places estimate (hotels) / mock (flights).
SERPAPI_KEY=

# Google Weather API for forecasts (days 0-10). Falls back to MAPS_API_KEY when
# unset; Open-Meteo covers days 11-14 without a key.
WEATHER_API_KEY=

# Optional stub server (`pnpm mock-server`, also started by docker compose) for
# adapter experiments. The app never calls it; mock mode uses in-process fixtures.
# MOCK_API_PORT=4000

# Next.js output directory. Use .next-dev for `pnpm dev` when building at the
# same time, so dev and production builds do not share .next.
# NEXT_DIST_DIR=.next

# Durable store (Upstash-compatible Redis REST) for chat turns, preferences,
# generated plans and SerpApi usage/cache. Without both values everything is
# kept in process memory, which resets on restart and on serverless cold starts.
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are accepted as well.
KV_REST_API_URL=
KV_REST_API_TOKEN=
